# CampusEats — environment variable reference
# Copy this file to .env for local development. Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# Local development uses SQLite (no variable needed).
# Production (Supabase transaction pooler — port 6543):
# DATABASE_URL=postgresql://user:pass@db.supabase.co:6543/postgres

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-long-random-string

# Server-side pepper mixed into every password hash.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PASSWORD_PEPPER=replace-me-with-another-long-random-string

# Optional token lifetime overrides (defaults shown):
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL in production:
# CORS_ORIGIN=https://your-app.vercel.app
